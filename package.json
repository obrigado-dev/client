{
  "name": "obrigado-client-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "fast-check": "4.10.2",
      "zod": "4.6.5"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "check": "bun run check:lint && bun run check:fmt && bun run check:types && bun run check:test",
    "check:lint": "oxlint --deny-warnings .",
    "check:fmt": "oxfmt --check .",
    "check:types": "tsc --build --force",
    "check:test": "bun test",
    "build:binaries": "bun run scripts/build-binaries.ts",
    "build:editors": "bun run scripts/build-editors.ts",
    "build:vscode": "bun run --filter obrigado-vscode build",
    "package:vscode": "bun run --filter obrigado-vscode package"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "lefthook": "2.1.15",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "markdown-it": "14.3.2",
    "nanoid": "3.3.19",
    "qs": "6.16.0",
    "seroval": "1.6.8",
    "seroval-plugins": "1.6.8"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.2"
}
