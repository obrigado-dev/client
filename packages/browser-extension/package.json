{
  "name": "obrigado-browser",
  "version": "0.1.0",
  "private": true,
  "description": "One sponsored status line beside your AI chats. 70% of gross revenue funds open source maintainer grants.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "submit:chrome": "wxt submit --chrome-api-version v2 --chrome-publish-type DEFAULT_PUBLISH",
    "prepare:types": "wxt prepare",
    "check:types": "wxt prepare && tsc --noEmit",
    "test:browser": "bun run build && bun run scripts/smoke.ts"
  },
  "dependencies": {
    "@obrigado/client": "workspace:*",
    "@obrigado/surface": "workspace:*"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "wxt": "0.21.4"
  }
}
